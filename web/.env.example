# Copy to .env.local and fill in. Never commit .env.local.
# Both values are shipped in the client bundle by design — Postgres RLS is the
# access control, not secrecy. Never put a service_role/secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# For the local stack (`npx supabase start`) the CLI prints fixed demo values:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<PUBLISHABLE_KEY from `npx supabase status`>

# Leaving both unset is supported: the app then runs local-only, with no sync.
